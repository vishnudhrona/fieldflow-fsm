# Dependency directories (subfolders are also ignored by sub-gitignores, but this is a safety net)
**/node_modules/
**/dist/
**/dev-dist/

# Env files (contains sensitive credentials)
**/.env
**/.env*.local

# System Files
.DS_Store
Thumbs.db

# Editor configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
**/logs/
**/*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
