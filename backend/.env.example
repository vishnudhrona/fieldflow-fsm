# ==============================================================================
# FieldFlow FSM - Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Configuration (Required)
PORT=8080
NODE_ENV=development

# JWT Authentication Secret (Required - min 32 chars recommended)
JWT_SECRET=your_development_jwt_secret_key_change_in_production_12345

# Database Configuration - PostgreSQL (Required)
# Option 1: Individual connection parameters (Standard for local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fieldflow_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Option 2: Full Database Connection URL (Alternative / Cloud databases)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fieldflow_db

# ==============================================================================
# AWS S3 Storage (Optional - Local demo falls back to Base64 data URLs)
# ==============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=